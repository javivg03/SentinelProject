# Configuración de Sentinel - Plantilla de ejemplo
TELEGRAM_TOKEN=tu_token_de_telegram_aqui
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
SPREADSHEET_ID=tu_id_de_google_sheets_aqui

# OBLIGATORIO: chat_id de Telegram autorizado a usar el bot (el tuyo).
# Sin esta variable, Sentinel rechaza TODOS los mensajes (fail-closed) para
# evitar que un tercero que descubra el bot pueda leer tu patrimonio o
# escribir en tu hoja de cálculo. Consíguelo hablando con @userinfobot en
# Telegram o mirando los logs tras un intento de acceso no autorizado.
ALLOWED_CHAT_ID=tu_chat_id_de_telegram_aqui

# Nota: Para el despliegue en la nube, se usará también:
# GOOGLE_SERVICE_ACCOUNT_JSON='{...contenido_del_json...}'